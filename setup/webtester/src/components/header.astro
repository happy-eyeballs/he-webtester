---
type Props = {
  titleLine1: string;
  titleLine2: string;
};

const { titleLine1, titleLine2 } = Astro.props;
---

<header>
  <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight">
    {titleLine1}
    <br />
    <span
      class="bg-gradient-to-r from-accent to-cyan-400 bg-clip-text text-transparent"
    >
      {titleLine2}
    </span>
  </h1>

  <div class="mt-6 max-w-2xl text-sm text-muted-foreground grid gap-2">
    <slot />
  </div>
</header>
