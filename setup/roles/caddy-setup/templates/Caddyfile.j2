### GLOBAL

{
    admin off

    servers {{ happy_eyeballs.webserver.ipv4 }}:443 {
        protocols h1
    }
    servers [{{ happy_eyeballs.webserver.ipv6 }}]:443 {
        protocols h1
    }

    {% for item in happy_eyeballs.webserver.delays %}
    servers {{ item.ipv4 }}:443 {
        protocols h1
    }
    servers [{{ item.ipv6 }}]:443 {
        protocols h1
    }
    {% endfor %}
}

### SNIPPETS

(cors) {
    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
        Access-Control-Max-Age 1728000
        Timing-Allow-Origin *
    }
}

(respond_with_client_ip) {
    templates {
        between (( ))
        mime text/plain
    }
    header Content-Type text/plain
    respond `((.ClientIP))`
}

(respond_with_server_ip) {
    templates {
        between (( ))
        mime text/plain
    }
    header Content-Type text/plain
    respond `((ph "http.request.local.host"))`
}

(respond_with_json) {
    templates {
        between (( ))
        mime application/json
    }
    header Content-Type application/json
    respond `{"server_ip": "((ph "http.request.local.host"))", "client_ip": "((ph "http.request.remote.host"))", "protocol": "((ph "http.request.proto"))"}`
}

### SERVERS

{{ happy_eyeballs.webtester.domains | join(', ') }} {
    bind {{ happy_eyeballs.webtester.ipv4 }} {{ happy_eyeballs.webtester.ipv6 }}

    tls {{ certbot.email }}

    handle /results/* {
        reverse_proxy {{ happy_eyeballs.uploadserver.host }}:{{ happy_eyeballs.uploadserver.port }}
    }

    handle {
        root * {{ happy_eyeballs.base_path }}/www-root
        file_server
    }
}

{{ happy_eyeballs_domains.v1_ipv4_only }}, {{ happy_eyeballs_domains.v1_ipv6_only }} {
    bind {{ happy_eyeballs.webserver.ipv4 }} {{ happy_eyeballs.webserver.ipv6 }}

    tls /etc/letsencrypt/live/{{ happy_eyeballs_domains.v1_ipv6_only }}/fullchain.pem /etc/letsencrypt/live/{{ happy_eyeballs_domains.v1_ipv6_only }}/privkey.pem

    import cors
    import respond_with_client_ip
}

{{ happy_eyeballs_domains.v1 | join(', ') }} {
    bind {% for item in happy_eyeballs.webserver.delays %}{{ item.ipv4 }} {{ item.ipv6 }} {% endfor %}

    tls /etc/letsencrypt/live/{{ happy_eyeballs_domains.v1 | first | replace('*.', '') }}/fullchain.pem /etc/letsencrypt/live/{{ happy_eyeballs_domains.v1 | first | replace('*.', '') }}/privkey.pem

    import cors
    import respond_with_server_ip
}

{{ happy_eyeballs_domains.v2 }} {
    bind {{ happy_eyeballs.webserver.ipv4 }} {{ happy_eyeballs.webserver.ipv6 }}

    tls /etc/letsencrypt/live/{{ happy_eyeballs_domains.v2 | replace('*.', '') }}/fullchain.pem /etc/letsencrypt/live/{{ happy_eyeballs_domains.v2 | replace('*.', '') }}/privkey.pem

    import cors
    import respond_with_server_ip
}

*.http3.v3-quic.{{ happy_eyeballs.nameserver.base_domain }}, *.http3-https.v3-quic.{{ happy_eyeballs.nameserver.base_domain }} {
    bind {{ happy_eyeballs.webserver.http3.ipv4 }} {{ happy_eyeballs.webserver.http3.ipv6 }}

    tls /etc/letsencrypt/live/{{ happy_eyeballs_domains.v3_quic.http3 | replace('*.', '') }}/fullchain.pem /etc/letsencrypt/live/{{ happy_eyeballs_domains.v3_quic.http3 | replace('*.', '') }}/privkey.pem
    tls /etc/letsencrypt/live/{{ happy_eyeballs_domains.v3_quic.http3_https | replace('*.', '') }}/fullchain.pem /etc/letsencrypt/live/{{ happy_eyeballs_domains.v3_quic.http3_https | replace('*.', '') }}/privkey.pem

    header -Alt-Svc

    import cors
    import respond_with_json
}

*.http3-altsvc.v3-quic.{{ happy_eyeballs.nameserver.base_domain }}, *.http3-https-altsvc.v3-quic.{{ happy_eyeballs.nameserver.base_domain }} {
    bind {{ happy_eyeballs.webserver.http3.ipv4 }} {{ happy_eyeballs.webserver.http3.ipv6 }}

    tls /etc/letsencrypt/live/{{ happy_eyeballs_domains.v3_quic.http3_altsvc | replace('*.', '') }}/fullchain.pem /etc/letsencrypt/live/{{ happy_eyeballs_domains.v3_quic.http3_altsvc | replace('*.', '') }}/privkey.pem
    tls /etc/letsencrypt/live/{{ happy_eyeballs_domains.v3_quic.http3_https_altsvc | replace('*.', '') }}/fullchain.pem /etc/letsencrypt/live/{{ happy_eyeballs_domains.v3_quic.http3_https_altsvc | replace('*.', '') }}/privkey.pem

    header Alt-Svc `h3=":443"; ma=60`

    import cors
    import respond_with_json
}
